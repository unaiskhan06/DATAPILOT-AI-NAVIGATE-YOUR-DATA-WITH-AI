# Copy this file to ".env". Agent Mode works with ANY OpenAI-compatible endpoint.
# Values are loaded at runtime and are NEVER committed or hardcoded.
#
# =============================================================================
#  DEFAULT: Ollama (FREE, UNLIMITED, LOCAL, NO API KEY, WORKS OFFLINE)
# =============================================================================
# 1. Install Ollama:            https://ollama.com/download
# 2. Pull a model (one time):   ollama pull llama3.1
#    (lighter option for weak PCs:  ollama pull llama3.2)
# 3. Make sure Ollama is running (it serves http://localhost:11434 automatically).
#
# These are already the built-in defaults, so you don't even need to set them.
# Uncomment to change the model:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1
# OPENAI_API_KEY is NOT required for Ollama. Leave it empty/unset.

# =============================================================================
#  Other free cloud options (uncomment ONE block instead of Ollama)
# =============================================================================
# --- Groq (free key from https://console.groq.com, no credit card) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_your_groq_key

# --- OpenRouter free models (free key from https://openrouter.ai) ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=sk-or-your-openrouter-key

# =============================================================================
# PORT=5000

# =============================================================================
#  Accounts & login (mandatory to use the Editor / Dashboard)
# =============================================================================
# Random long string used to sign login-session cookies and email-verification
# tokens. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-this-to-a-random-secret

# Public base URL of this app (used to build the email-verification link).
# APP_BASE_URL=http://127.0.0.1:5000

# --- Email verification (signup with Gmail + a new password) ---
# If left unset, the verification link is printed to the server console (and
# returned in the API response) instead of emailed — handy for local testing.
# For Gmail: enable 2-Step Verification, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use it below (NOT your normal
# Gmail password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.name@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your.name@gmail.com

# --- "Continue with Google" login ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add this Authorized redirect URI:
#   http://127.0.0.1:5000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback
